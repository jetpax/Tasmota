{
  "build": {
    "arduino":{
      "ldscript": "esp32s3_out.ld",
      "cdc_on_boot": false,
      "psram_type": "spi"
    },
    "chip_family": "esp32s3",
    "core": "esp32",
    "extra_flags": [
        "-DARDUINO_TASMOTA",  
        "-DARDUINO_ESP32S3_DEV",
        "-DARDUINO_RUNNING_CORE=1",
        "-DARDUINO_EVENT_RUNNING_CORE=1",
        "-DBOARD_HAS_PSRAM",
        "-DESP32S3",
        "-DARDUINO_USB_MODE=0",
        "-DARDUINO_USB_CDC_ON_BOOT=0",
        "-DCONFIG_TINYUSB_ENABLED=1 ",
        "-DARDUINO_USB_HOST_ENABLED=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
      [
        "0x303A",
        "0x1001"
      ]
    ],
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "partitions": "partitions/esp32_partition_app3904k_fs11M.csv"
  },
  "connectivity": [
    "bluetooth",
    "wifi"
  ],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "RetroVMS-MINI (16MB flash, 2MB PSRAM)",
  "upload": {
    "arduino": {
      "flash_extra_images": [
        [
          "0x10000",
          "tasmota32s3-safeboot.bin"
        ]
      ]
    },
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://www.retrovms.com/mini/welcome",
  "vendor": "RetroVMS"
}
